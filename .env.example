# ==============================================
# GitOps Pipeline — Environment Variables
# ==============================================

# ArgoCD Notifications - Webhook Configuration
# Get a unique URL from https://webhook.site
WEBHOOK_URL=https://webhook.site/your-unique-id

# ArgoCD Admin Password (auto-generated during setup)
ARGOCD_ADMIN_PASSWORD=

# Git Repository URL
GIT_REPO_URL=https://github.com/raghavendra2006/Implement-a-Kubernetes-GitOps-Deployment-Pipeline-with-ArgoCD.git
